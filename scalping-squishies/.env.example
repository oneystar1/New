# Copy to .env.local for dev or set as CI secrets for release builds.
# Backend base URL. Leave empty to run fully offline with local saves only.
VITE_API_URL=
# AdMob ad unit ids. Defaults are Google's public test ids; set VITE_ADMOB_TESTING=false for release.
VITE_ADMOB_REWARDED=
VITE_ADMOB_INTERSTITIAL=
VITE_ADMOB_TESTING=true
# RevenueCat public iOS SDK key. Empty disables purchases on device.
VITE_RC_IOS_KEY=
VITE_APP_VERSION=0.1.0
# Public site (GitHub Pages by default). Privacy and support pages are served from here.
VITE_SITE_URL=https://oneystar1.github.io/New/
# Where the in-game Send feedback button and the legal pages point. Empty = support page only.
VITE_SUPPORT_EMAIL=
