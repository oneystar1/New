# Signing certificates and profiles live encrypted in a private git repo
# (MATCH_GIT_URL) so CI can sign builds without a Mac. MATCH_PASSWORD
# encrypts them; MATCH_GIT_BASIC_AUTHORIZATION is base64("user:token").
git_url(ENV["MATCH_GIT_URL"])
storage_mode("git")
type("appstore")
app_identifier(["com.oneycollectibles.scalpingsquishies"])
