{
  "name": "scalping-squishies",
  "version": "0.1.0",
  "private": true,
  "description": "Scalping Squishies: an idle flipping tycoon about scalping squishy toys and dough cubes. Web first, iOS via Capacitor.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "soak": "node tests/soak.mjs",
    "balance": "tsx tools/balance.ts",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
