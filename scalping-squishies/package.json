{
  "name": "scalping-squishies",
  "version": "0.1.0",
  "private": true,
  "description": "Scalping Squishies: an idle flipping tycoon about scalping squishy toys and dough cubes. Web first, iOS via Capacitor.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "soak": "node tests/soak.mjs",
    "server": "node server/index.mjs",
    "test:server": "node --test server/test.mjs",
    "balance": "tsx tools/balance.ts",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@revenuecat/purchases-capacitor": "^13.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
